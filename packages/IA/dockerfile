FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .

# PyTorch só para CPU: imagem bem menor que a versão com CUDA.
# Para GPU, troque o índice por https://download.pytorch.org/whl/cu130
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision && \
    pip install --no-cache-dir -r requirements.txt

# Não roda como root (arquivos já copiados com o dono certo, sem duplicar a camada dos modelos)
RUN useradd --create-home agroscope

# Código e modelos em camadas separadas (uma por cultura) em vez de um único
# COPY . . — um blob de ~1.2GB numa camada só é frágil demais pra dar push
# em conexões instáveis (qualquer soluço de rede derruba o upload inteiro e
# tem que recomeçar do zero). Camadas menores retomam independentemente.
COPY --chown=agroscope:agroscope app.py .
COPY --chown=agroscope:agroscope core/ ./core/
COPY --chown=agroscope:agroscope models/Coffee ./models/Coffee
COPY --chown=agroscope:agroscope models/Corn ./models/Corn
COPY --chown=agroscope:agroscope models/Gate ./models/Gate
COPY --chown=agroscope:agroscope models/Soybean ./models/Soybean
COPY --chown=agroscope:agroscope models/Tomato ./models/Tomato
COPY --chown=agroscope:agroscope models/Wheat ./models/Wheat
USER agroscope

ENV SERVER_PORT=5000
EXPOSE 5000

# Docker marca o contêiner como "unhealthy" se a API parar de responder
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"SERVER_PORT\"]}/health', timeout=4)"

CMD ["python", "app.py"]
