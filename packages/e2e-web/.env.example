# Copie para .env e ajuste se a stack de teste rodar em outra máquina/portas.

# URL pública da aplicação, servida pelo nginx (deve ser "localhost" mesmo, e não
# 127.0.0.1 ou o nome de um serviço docker: o backend seta cookies de sessão com
# Secure+SameSite=None, e o Chromium só trata esses cookies como válidos em HTTP
# quando o host é exatamente "localhost").
BASE_URL=http://localhost

# String de conexão do Postgres publicado pelo docker-compose.test.yml (porta
# mapeada 5433 -> 5432 dentro do container). Usada apenas pelos helpers de teste
# que precisam ler/ajustar o código de recuperação de senha (ver support/db.ts) --
# não há como obter esse código pela UI, pois o e-mail não é realmente enviado
# nesse ambiente (não há mail-catcher configurado).
DATABASE_URL=postgres://agroscope:agroscope@localhost:5433/agroscope_e2e
