NEXT_PUBLIC_API_URL=http://localhost:3001

# Modo de apresentação: intercepta todas as chamadas HTTP com dados mock.
# Remova ou defina como false para usar o backend real.
NEXT_PUBLIC_MOCK=false

# Usado apenas por next.config.mjs (rewrites) quando o front e o backend estão
# em domínios diferentes (ex: Vercel + EC2): com NEXT_PUBLIC_API_URL=/api, o
# Next.js proxya as chamadas para BACKEND_ORIGIN/api/*, fazendo o cookie de
# sessão (httpOnly) ficar first-party do domínio do front. Não precisa disso
# em dev local, onde front e backend compartilham o host "localhost".
BACKEND_ORIGIN=http://localhost:3001
